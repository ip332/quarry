#!/usr/bin/env python3
"""Validate exact Quarry commits before pushing them.

`git push` connects to the remote before it runs the pre-push hook, and the
remote closes an idle connection long before the full configure/build/test
cycle finishes (issue #89). Validation therefore runs here, before any
connection exists, and records a receipt. The pre-push hook only checks that
every outgoing commit has a passing receipt for the current environment.

  scripts/quarry-validate validate [<rev>...]       validate commits (default HEAD)
  scripts/quarry-validate push [<git push args>...]  push, validating what the push needs
  scripts/quarry-validate status [<rev>...]         show receipt state
  scripts/quarry-validate install-hook [--force]    install the pre-push hook
  scripts/quarry-validate check-push <remote> <url> pre-push hook mode (refs on stdin)

State lives under `git rev-parse --git-common-dir`/quarry-validation and is
shared by every linked worktree: the validation worktree, receipts, logs and a
lock. Nothing there is ever part of a working tree.
"""

from __future__ import annotations

import argparse
import concurrent.futures
import contextlib
import datetime
import errno
import fcntl
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time

# Bump when what a receipt certifies changes (commands, checks, fingerprint).
PROTOCOL = 1
PRESET = "debug"
STATE_DIR_NAME = "quarry-validation"
HOOK_MARKER = "Quarry pre-push receipt check"
PRE_COMMIT_MARKER = "File generated by pre-commit"
PENDING_ENV = "QUARRY_VALIDATE_PENDING"
BUILD_JOBS_ENV = "QUARRY_VALIDATE_BUILD_JOBS"
TEST_JOBS_ENV = "QUARRY_VALIDATE_TEST_JOBS"
ZERO_SHA_RE = re.compile(r"^0+$")
SHA_RE = re.compile(r"^[0-9a-f]{40}([0-9a-f]{24})?$")

# Variables that select or reconfigure a repository (#94, #96). Git reports
# its own list through `git rev-parse --local-env-vars`; this copy covers
# older Git releases. The whole GIT_CONFIG* family is removed as well.
_REPOSITORY_LOCAL_GIT_VARIABLES = frozenset({
    "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_COMMON_DIR", "GIT_CONFIG",
    "GIT_CONFIG_COUNT", "GIT_CONFIG_PARAMETERS", "GIT_DIR", "GIT_GRAFT_FILE",
    "GIT_IMPLICIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_INTERNAL_SUPER_PREFIX",
    "GIT_NAMESPACE", "GIT_NO_REPLACE_OBJECTS", "GIT_OBJECT_DIRECTORY", "GIT_PREFIX",
    "GIT_REPLACE_REF_BASE", "GIT_SHALLOW_FILE", "GIT_WORK_TREE", "GIT_EXEC_PATH",
})

# Tools whose identity can change a validation result.
_FINGERPRINT_TOOLS = (
    ("git", "--version"),
    ("cmake", "--version"),
    ("ctest", "--version"),
    ("make", "--version"),
    ("cc", "--version"),
    ("c++", "--version"),
    ("python3", "--version"),
    ("go", "version"),
    ("protoc", "--version"),
    ("pkg-config", "--version"),
)
_PKG_CONFIG_MODULES = ("protobuf", "absl_base", "yaml-0.1")
_PYTHON_DISTRIBUTIONS = ("build", "setuptools", "protobuf")
_FINGERPRINT_ENV = (
    "CC", "CXX", "CFLAGS", "CXXFLAGS", "CPPFLAGS", "LDFLAGS", "LIBRARY_PATH",
    "CPATH", "C_INCLUDE_PATH", "CPLUS_INCLUDE_PATH", "SDKROOT",
    "MACOSX_DEPLOYMENT_TARGET", "DEVELOPER_DIR", "PKG_CONFIG_PATH",
    "PKG_CONFIG_LIBDIR", "CMAKE_PREFIX_PATH", "CMAKE_GENERATOR",
    "CMAKE_TOOLCHAIN_FILE", "CMAKE_C_COMPILER_LAUNCHER", "CMAKE_CXX_COMPILER_LAUNCHER",
    "GOROOT", "GOPATH", "GOFLAGS", "GOTOOLCHAIN", "GOPROXY", "GO111MODULE",
    "CGO_ENABLED", "PYTHONPATH", "PYTHONHOME", "VIRTUAL_ENV",
)
_UNFINGERPRINTED_QUARRY_ENV = frozenset({PENDING_ENV, BUILD_JOBS_ENV, TEST_JOBS_ENV})


class ValidateError(Exception):
    """A user-facing error: printed without a traceback."""


def say(message: str) -> None:
    print(f"quarry-validate: {message}", file=sys.stderr, flush=True)


# --------------------------------------------------------------------------
# Environment


def _git_exec_path_entries(environment: dict[str, str]) -> set[str]:
    entries = set()
    exec_path = environment.get("GIT_EXEC_PATH")
    if exec_path:
        entries.add(os.path.normpath(exec_path))
    return entries


def clean_path(environment: dict[str, str]) -> str:
    """PATH without the exec-path entry Git prepends for hooks."""
    drop = _git_exec_path_entries(environment)
    kept = []
    for entry in environment.get("PATH", "").split(os.pathsep):
        if not entry:
            continue
        normalized = os.path.normpath(entry)
        if normalized in drop or normalized.endswith(os.path.join("libexec", "git-core")):
            continue
        kept.append(entry)
    return os.pathsep.join(kept)


def sanitized_environment(base: dict[str, str] | None = None) -> dict[str, str]:
    """`base` (default os.environ) without inherited repository selection.

    Hooks run with GIT_DIR (linked worktrees), GIT_CONFIG_PARAMETERS
    (`git -c`) and a PATH that starts with Git's exec-path. None of these may
    reach the commands that validate a commit (#94).
    """
    source = dict(os.environ if base is None else base)
    without_git = {key: value for key, value in source.items() if not key.startswith("GIT_")}
    reported: frozenset[str] = frozenset()
    git = shutil.which("git", path=clean_path(source))
    if git:
        result = subprocess.run([git, "rev-parse", "--local-env-vars"], env=without_git,
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                text=True, check=False)
        if result.returncode == 0:
            reported = frozenset(result.stdout.split())
    environment = {key: value for key, value in source.items()
                   if key not in _REPOSITORY_LOCAL_GIT_VARIABLES and key not in reported
                   and not key.startswith("GIT_CONFIG")}
    environment["PATH"] = clean_path(source)
    return environment


def _probe(command: list[str], environment: dict[str, str]) -> str:
    try:
        result = subprocess.run(command, env=environment, cwd=tempfile.gettempdir(),
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, check=False, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as error:
        return f"<error: {error.__class__.__name__}>"
    output = result.stdout.strip()
    return output if result.returncode == 0 else f"<exit {result.returncode}> {output}"


def environment_description(environment: dict[str, str]) -> dict:
    """Everything outside the commit that can change a validation result."""
    path = environment.get("PATH", "")
    resolved = {tool: shutil.which(tool, path=path) for tool, *_ in _FINGERPRINT_TOOLS}
    probes: dict[tuple[str, str], list[str]] = {}
    for tool, *arguments in _FINGERPRINT_TOOLS:
        if resolved[tool]:
            probes[("tool", tool)] = [resolved[tool], *arguments]
    if resolved["pkg-config"]:
        for module in _PKG_CONFIG_MODULES:
            probes[("pkg-config", module)] = [resolved["pkg-config"], "--modversion", module]
    if resolved["python3"]:
        # Probe from a neutral directory with -I: a source tree's build/
        # directory would otherwise import as a namespace package (#88).
        script = ("import json, importlib.metadata as m\n"
                  "def v(n):\n"
                  "    try:\n        return m.version(n)\n"
                  "    except Exception:\n        return None\n"
                  f"print(json.dumps({{n: v(n) for n in {list(_PYTHON_DISTRIBUTIONS)!r}}}))\n")
        probes[("python", "distributions")] = [resolved["python3"], "-I", "-c", script]
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        futures = {key: pool.submit(_probe, command, environment)
                   for key, command in probes.items()}
        output = {key: future.result() for key, future in futures.items()}
    tools = {tool: {"path": os.path.realpath(resolved[tool]) if resolved[tool] else None,
                    "version": output.get(("tool", tool))}
             for tool, *_ in _FINGERPRINT_TOOLS}
    modules = {module: output.get(("pkg-config", module)) for module in _PKG_CONFIG_MODULES}
    distributions: dict = {name: None for name in _PYTHON_DISTRIBUTIONS}
    if ("python", "distributions") in output:
        try:
            distributions = json.loads(output[("python", "distributions")])
        except ValueError:
            distributions = {"<probe>": output[("python", "distributions")]}
    variables = {key: environment.get(key) for key in _FINGERPRINT_ENV}
    variables.update({key: value for key, value in environment.items()
                      if key.startswith("QUARRY_") and key not in _UNFINGERPRINTED_QUARRY_ENV})
    return {
        "protocol": PROTOCOL,
        "preset": PRESET,
        "system": platform.system(),
        "release": platform.release(),
        "machine": platform.machine(),
        "mac_version": platform.mac_ver()[0],
        "tools": tools,
        "pkg_config": modules,
        "python_distributions": distributions,
        "variables": dict(sorted(variables.items())),
    }


def fingerprint_of(description: dict) -> str:
    blob = json.dumps(description, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(blob).hexdigest()


def describe_difference(old: dict, new: dict, prefix: str = "") -> list[str]:
    differences = []
    for key in sorted(set(old) | set(new)):
        before, after = old.get(key), new.get(key)
        if before == after:
            continue
        name = f"{prefix}{key}"
        if isinstance(before, dict) and isinstance(after, dict):
            differences.extend(describe_difference(before, after, name + "."))
        else:
            differences.append(f"{name}: {short_value(before)} -> {short_value(after)}")
    return differences


def short_value(value) -> str:
    text = json.dumps(value) if not isinstance(value, str) else value
    text = text.splitlines()[0] if text else text
    return text if len(text) <= 80 else text[:77] + "..."


# --------------------------------------------------------------------------
# Repository


class Repository:
    """The repository being validated, addressed only by explicit paths."""

    def __init__(self) -> None:
        # Discovery is the only step that uses the inherited environment: a
        # hook in a linked worktree identifies its repository through GIT_DIR.
        inherited = dict(os.environ)
        inherited["PATH"] = clean_path(inherited)
        git = shutil.which("git", path=inherited["PATH"])
        if git is None:
            raise ValidateError("git was not found on PATH")
        result = subprocess.run(
            [git, "rev-parse", "--path-format=absolute", "--absolute-git-dir",
             "--git-common-dir"],
            env=inherited, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            check=False)
        if result.returncode != 0:
            raise ValidateError("not inside a Git repository: " + result.stderr.strip())
        lines = result.stdout.splitlines()
        if len(lines) != 2:
            raise ValidateError("unexpected `git rev-parse` output (Git 2.31 or newer is required)")
        self.git_dir = Path(lines[0])
        self.common_dir = Path(lines[1])
        self.environment = sanitized_environment()
        self.git_executable = shutil.which("git", path=self.environment["PATH"]) or git
        self.state_dir = self.common_dir / STATE_DIR_NAME
        self.worktree = self.state_dir / "worktree"
        self.receipts_dir = self.state_dir / "receipts"
        self.logs_dir = self.state_dir / "logs"
        self.lock_path = self.state_dir / "lock"

    def git(self, *arguments: str, cwd: Path | None = None, check: bool = True,
            git_dir: bool = True) -> str:
        command = [self.git_executable]
        if git_dir:
            command.append(f"--git-dir={self.git_dir}")
        command.extend(arguments)
        result = subprocess.run(command, cwd=cwd, env=self.environment,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                                check=False)
        if check and result.returncode != 0:
            raise ValidateError(f"`git {' '.join(arguments)}` failed: {result.stderr.strip()}")
        return result.stdout.strip() if result.returncode == 0 else ""

    def worktree_git(self, *arguments: str, check: bool = True) -> str:
        return self.git("-C", str(self.worktree), *arguments, check=check, git_dir=False)

    def resolve_commit(self, revision: str) -> str:
        sha = self.git("rev-parse", "--verify", "--quiet", "--end-of-options",
                       revision + "^{commit}", check=False)
        if not SHA_RE.match(sha):
            raise ValidateError(f"{revision!r} does not name a commit")
        return sha

    def peel_pushed_object(self, sha: str) -> tuple[str | None, str]:
        """The commit a pushed object stands for, or (None, reason)."""
        kind = self.git("cat-file", "-t", sha, check=False)
        if kind == "commit":
            return sha, ""
        if kind == "tag":
            commit = self.git("rev-parse", "--verify", "--quiet", sha + "^{commit}",
                              check=False)
            if SHA_RE.match(commit):
                return commit, ""
            return None, f"tag {sha[:12]} does not point to a commit"
        if not kind:
            return None, f"object {sha[:12]} is not in this repository"
        return None, f"{kind} {sha[:12]} is not a commit"

    def version_metadata(self, commit: str) -> dict:
        """The Git-derived inputs cmake/QuarryVersion.cmake reads for `commit`."""
        shallow = self.git("rev-parse", "--is-shallow-repository", check=False) == "true"
        if shallow:
            return {"shallow": True}
        base = self.git("log", "-1", "--format=%H", commit, "--", "git_version", check=False)
        revision = None
        if base:
            count = self.git("rev-list", "--count", f"{base}..{commit}")
            revision = int(count)
        return {
            "shallow": False,
            "git_version_base": base or None,
            "revision": revision,
            "short_sha": self.git("rev-parse", "--short", commit),
        }


# --------------------------------------------------------------------------
# Receipts


def receipt_dir(repo: Repository, commit: str) -> Path:
    return repo.receipts_dir / commit


def receipt_path(repo: Repository, commit: str, fingerprint: str) -> Path:
    return receipt_dir(repo, commit) / f"{fingerprint}.json"


def write_json_atomically(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=path.name + ".", suffix=".tmp",
                                             dir=str(path.parent))
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(data, stream, indent=1, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(temporary)
        raise


def load_receipts(repo: Repository, commit: str) -> list[tuple[Path, dict | None]]:
    directory = receipt_dir(repo, commit)
    if not directory.is_dir():
        return []
    receipts = []
    for path in sorted(directory.glob("*.json")):
        try:
            receipts.append((path, json.loads(path.read_text(encoding="utf-8"))))
        except (OSError, ValueError):
            receipts.append((path, None))
    return receipts


def invalidate_receipts(repo: Repository, commit: str) -> None:
    """Remove every receipt for `commit` before it is validated again."""
    directory = receipt_dir(repo, commit)
    if directory.is_dir():
        for path in directory.iterdir():
            with contextlib.suppress(FileNotFoundError):
                path.unlink()


def evaluate(repo: Repository, commit: str, fingerprint: str,
             description: dict) -> tuple[bool, str]:
    """Whether `commit` has a receipt that authorizes a push now, and why not."""
    receipts = load_receipts(repo, commit)
    if not receipts:
        return False, "not validated"
    current = None
    for path, data in receipts:
        if path.name == f"{fingerprint}.json":
            current = (path, data)
    if current is None:
        recorded = [data for _, data in receipts if isinstance(data, dict)
                    and data.get("result") == "pass"
                    and isinstance(data.get("environment"), dict)]
        if recorded:
            changes = describe_difference(recorded[-1]["environment"], description)
            detail = "; ".join(changes[:3]) + (" ..." if len(changes) > 3 else "")
            return False, f"validated in a different environment ({detail})"
        return False, "not validated in this environment"
    path, data = current
    if not isinstance(data, dict):
        return False, f"receipt {path} is unreadable"
    if data.get("protocol") != PROTOCOL:
        return False, (f"receipt uses validation protocol {data.get('protocol')!r}, "
                       f"expected {PROTOCOL}")
    if data.get("commit") != commit or data.get("fingerprint") != fingerprint:
        return False, f"receipt {path} does not describe this commit and environment"
    result = data.get("result")
    if result == "running":
        return False, "validation is in progress or was killed"
    if result == "interrupted":
        return False, "validation was interrupted"
    if result != "pass":
        log = data.get("log")
        return False, f"validation failed ({data.get('failed_step', 'unknown step')}; log: {log})"
    expected = repo.version_metadata(commit)
    if data.get("version_metadata") != expected:
        changes = describe_difference(data.get("version_metadata") or {}, expected)
        return False, "Git-derived version metadata changed (" + "; ".join(changes) + ")"
    return True, f"validated {data.get('finished', '?')} in {data.get('duration_s', '?')}s"


# --------------------------------------------------------------------------
# Validation


@contextlib.contextmanager
def validation_lock(repo: Repository):
    repo.state_dir.mkdir(parents=True, exist_ok=True)
    with open(repo.lock_path, "a+", encoding="utf-8") as stream:
        try:
            fcntl.flock(stream.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError as error:
            if error.errno not in (errno.EAGAIN, errno.EACCES, errno.EWOULDBLOCK):
                raise
            stream.seek(0)
            holder = stream.read().strip() or "another session"
            say(f"waiting for the validation lock held by {holder}")
            fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
        stream.seek(0)
        stream.truncate()
        stream.write(f"pid {os.getpid()} on {platform.node()}\n")
        stream.flush()
        try:
            yield
        finally:
            stream.seek(0)
            stream.truncate()
            stream.flush()
            fcntl.flock(stream.fileno(), fcntl.LOCK_UN)


def registered_worktrees(repo: Repository) -> set[Path]:
    listing = repo.git("worktree", "list", "--porcelain")
    return {Path(line[len("worktree "):]).resolve() for line in listing.splitlines()
            if line.startswith("worktree ")}


def prepare_worktree(repo: Repository, commit: str) -> None:
    worktree = repo.worktree
    registered = worktree.resolve() in registered_worktrees(repo)
    if not (worktree / ".git").exists():
        if worktree.exists() and any(worktree.iterdir()):
            raise ValidateError(f"{worktree} exists but is not a Git worktree; remove it")
        arguments = ["worktree", "add", "--detach"]
        if registered:
            arguments.append("--force")  # registered, but its directory was deleted
        repo.git(*arguments, str(worktree), commit)
    else:
        repo.worktree_git("checkout", "--quiet", "--detach", "--force", commit)
    head = repo.worktree_git("rev-parse", "HEAD")
    if head != commit:
        raise ValidateError(f"validation worktree is at {head}, expected {commit}")
    repo.worktree_git("clean", "-ffdxq", "-e", "/build/")
    status = repo.worktree_git("status", "--porcelain", "--untracked-files=all",
                               "--ignored=no", "--", ".", ":(top,exclude)build")
    if status:
        raise ValidateError("validation worktree is not clean after checkout:\n" + status)


def preset_binary_dir(source_dir: Path) -> Path:
    """The binaryDir of the configure preset, as CMake expands it."""
    presets = json.loads((source_dir / "CMakePresets.json").read_text(encoding="utf-8"))
    by_name = {preset.get("name"): preset for preset in presets.get("configurePresets", [])}
    name: str | None = PRESET
    while name is not None:
        preset = by_name.get(name)
        if preset is None:
            break
        if "binaryDir" in preset:
            value = preset["binaryDir"].replace("${sourceDir}", str(source_dir))
            if "$" in value:
                raise ValidateError(f"unsupported macro in binaryDir of preset {name}: {value}")
            return Path(value)
        inherits = preset.get("inherits")
        name = inherits[0] if isinstance(inherits, list) and inherits else inherits
    raise ValidateError(f"preset {PRESET!r} defines no binaryDir")


def invalidate_stale_cmake_cache(binary_dir: Path, fingerprint: str) -> None:
    marker = binary_dir / ".quarry-validate-fingerprint"
    recorded = marker.read_text(encoding="utf-8").strip() if marker.exists() else None
    if recorded == fingerprint:
        return
    cache = binary_dir / "CMakeCache.txt"
    if cache.exists() or (binary_dir / "CMakeFiles").exists():
        say("toolchain or environment changed since the last validation build; "
            "discarding the CMake cache")
        with contextlib.suppress(FileNotFoundError):
            cache.unlink()
        shutil.rmtree(binary_dir / "CMakeFiles", ignore_errors=True)
    binary_dir.mkdir(parents=True, exist_ok=True)
    marker.write_text(fingerprint + "\n", encoding="utf-8")


def check_generated_version(binary_dir: Path, expected: dict) -> str | None:
    """Compare the configured version header with the Git-derived metadata."""
    header = binary_dir / "generated" / "quarry" / "version.hpp"
    if not header.exists():
        return f"configure did not generate {header}"
    defines = dict(re.findall(r"^#define\s+(\w+)\s+(.*)$",
                              header.read_text(encoding="utf-8"), re.MULTILINE))
    if expected.get("shallow"):
        return None  # CMake falls back to packaged metadata; nothing Git-derived to compare.
    revision = expected["revision"] if expected["revision"] is not None else 0
    actual = (defines.get("QUARRY_VERSION_REVISION"), defines.get("QUARRY_GIT_SHA"),
              defines.get("QUARRY_VERSION_DIRTY"))
    wanted = (str(revision), f'"{expected["short_sha"]}"', "FALSE")
    if actual != wanted:
        return (f"generated version metadata {actual} does not match the commit's "
                f"Git-derived metadata {wanted}")
    return None


def run_logged(command: list[str], cwd: Path, environment: dict[str, str], log) -> int:
    log.write(f"\n$ {' '.join(command)}\n")
    log.flush()
    process = subprocess.Popen(command, cwd=cwd, env=environment, stdout=subprocess.PIPE,
                               stderr=subprocess.STDOUT, text=True, bufsize=1)
    assert process.stdout is not None
    try:
        for line in process.stdout:
            sys.stdout.write(line)
            log.write(line)
        return process.wait()
    except BaseException:
        with contextlib.suppress(ProcessLookupError):
            process.send_signal(signal.SIGINT)
        with contextlib.suppress(subprocess.TimeoutExpired):
            process.wait(timeout=30)
        if process.poll() is None:
            process.kill()
            process.wait()
        raise


def utc_now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def jobs(value: int | None, variable: str) -> int:
    if value is None and os.environ.get(variable):
        try:
            value = int(os.environ[variable])
        except ValueError:
            raise ValidateError(f"{variable} must be a positive integer") from None
    if value is None:
        value = os.cpu_count() or 1
    if value < 1:
        raise ValidateError(f"job counts must be positive (got {value})")
    return value


def validate_commit(repo: Repository, commit: str, build_jobs: int, test_jobs: int,
                    clean: bool) -> bool:
    description = environment_description(repo.environment)
    fingerprint = fingerprint_of(description)
    metadata = repo.version_metadata(commit)
    invalidate_receipts(repo, commit)
    path = receipt_path(repo, commit, fingerprint)
    repo.logs_dir.mkdir(parents=True, exist_ok=True)
    log_path = repo.logs_dir / f"{commit}.log"
    receipt = {
        "protocol": PROTOCOL,
        "commit": commit,
        "tree": repo.git("rev-parse", commit + "^{tree}"),
        "fingerprint": fingerprint,
        "environment": description,
        "version_metadata": metadata,
        "preset": PRESET,
        "build_jobs": build_jobs,
        "test_jobs": test_jobs,
        "log": str(log_path),
        "result": "running",
        "started": utc_now(),
        "steps": {},
    }
    write_json_atomically(path, receipt)
    started = time.monotonic()
    say(f"validating {commit} (build jobs {build_jobs}, test jobs {test_jobs}); log: {log_path}")
    try:
        with open(log_path, "w", encoding="utf-8") as log:
            log.write(f"quarry-validate {commit} started {receipt['started']}\n")
            prepare_worktree(repo, commit)
            binary_dir = preset_binary_dir(repo.worktree)
            if repo.worktree / "build" not in binary_dir.parents:
                raise ValidateError(f"preset {PRESET!r} must build below build/ "
                                    f"(got {binary_dir})")
            if clean:
                say(f"--clean: removing {binary_dir}")
                shutil.rmtree(binary_dir, ignore_errors=True)
            invalidate_stale_cmake_cache(binary_dir, fingerprint)
            steps = [
                ("configure", ["cmake", "--preset", PRESET]),
                ("build", ["cmake", "--build", "--preset", PRESET, "--parallel",
                           str(build_jobs)]),
                ("test", ["ctest", "--preset", PRESET, "-j", str(test_jobs),
                          "--no-tests=error"]),
            ]
            for name, command in steps:
                step_started = time.monotonic()
                status = run_logged(command, repo.worktree, repo.environment, log)
                receipt["steps"][name] = round(time.monotonic() - step_started, 1)
                if status != 0:
                    receipt["failed_step"] = name
                    break
                if name == "configure":
                    mismatch = check_generated_version(binary_dir, metadata)
                    if mismatch:
                        log.write(mismatch + "\n")
                        say(mismatch)
                        receipt["failed_step"] = "version-metadata"
                        break
            # The environment must not have changed while validation ran.
            if "failed_step" not in receipt and \
                    fingerprint_of(environment_description(repo.environment)) != fingerprint:
                receipt["failed_step"] = "environment-changed-during-validation"
        receipt["result"] = "fail" if "failed_step" in receipt else "pass"
    except KeyboardInterrupt:
        receipt["result"] = "interrupted"
        raise
    except ValidateError as error:
        receipt["result"] = "fail"
        receipt["failed_step"] = f"setup: {error}"
        say(str(error))
    finally:
        receipt["finished"] = utc_now()
        receipt["duration_s"] = round(time.monotonic() - started, 1)
        write_json_atomically(path, receipt)
    steps = ", ".join(f"{name} {seconds}s" for name, seconds in receipt["steps"].items())
    if receipt["result"] == "pass":
        say(f"PASS {commit} in {receipt['duration_s']}s ({steps})")
        return True
    say(f"FAIL {commit}: {receipt.get('failed_step')} after {receipt['duration_s']}s; "
        f"log: {log_path}")
    return False


def validate_commits(repo: Repository, commits: list[str], args) -> bool:
    build_jobs = jobs(args.build_jobs, BUILD_JOBS_ENV)
    test_jobs = jobs(args.test_jobs, TEST_JOBS_ENV)
    unique = list(dict.fromkeys(commits))
    with validation_lock(repo):
        for commit in unique:
            if not args.force:
                description = environment_description(repo.environment)
                valid, _ = evaluate(repo, commit, fingerprint_of(description), description)
                if valid:
                    say(f"{commit} already has a valid receipt (use --force to revalidate)")
                    continue
            if not validate_commit(repo, commit, build_jobs, test_jobs, args.clean):
                return False
    return True


# --------------------------------------------------------------------------
# Commands


def command_validate(args) -> int:
    repo = Repository()
    commits = [repo.resolve_commit(revision) for revision in (args.revisions or ["HEAD"])]
    return 0 if validate_commits(repo, commits, args) else 1


def command_status(args) -> int:
    repo = Repository()
    description = environment_description(repo.environment)
    fingerprint = fingerprint_of(description)
    all_valid = True
    for revision in args.revisions or ["HEAD"]:
        commit = repo.resolve_commit(revision)
        valid, reason = evaluate(repo, commit, fingerprint, description)
        all_valid = all_valid and valid
        print(f"{'valid  ' if valid else 'INVALID'} {commit} {revision}: {reason}")
    return 0 if all_valid else 1


def command_check_push(args) -> int:
    started = time.monotonic()
    repo = Repository()
    description = environment_description(repo.environment)
    fingerprint = fingerprint_of(description)
    problems: list[str] = []
    missing: list[str] = []
    checked: dict[str, tuple[bool, str]] = {}
    lines = [line for line in sys.stdin.read().splitlines() if line.strip()]
    for line in lines:
        parts = line.split()
        if len(parts) != 4:
            problems.append(f"unexpected pre-push input line: {line!r}")
            continue
        local_ref, local_sha, remote_ref, _ = parts
        if ZERO_SHA_RE.match(local_sha):
            continue  # deletion: there is nothing to validate
        commit, reason = repo.peel_pushed_object(local_sha)
        if commit is None:
            problems.append(f"{local_ref} -> {remote_ref}: {reason}")
            continue
        if commit not in checked:
            checked[commit] = evaluate(repo, commit, fingerprint, description)
        valid, reason = checked[commit]
        if not valid:
            problems.append(f"{local_ref} -> {remote_ref}: {commit[:12]} {reason}")
            missing.append(commit)
    elapsed = time.monotonic() - started
    pending = os.environ.get(PENDING_ENV)
    if pending:
        with open(pending, "w", encoding="utf-8") as stream:
            stream.write("".join(f"{commit}\n" for commit in dict.fromkeys(missing)))
    for problem in problems:
        print(f"quarry pre-push: {problem}", file=sys.stderr)
    if problems:
        if missing:
            print("quarry pre-push: validate with `scripts/quarry-validate validate "
                  + " ".join(dict.fromkeys(missing)) + "` and push again,", file=sys.stderr)
            print("quarry pre-push: or push with `scripts/quarry-validate push <git push "
                  "arguments>`", file=sys.stderr)
        print("quarry pre-push: do not bypass this check with --no-verify "
              "(CONTRIBUTING.md)", file=sys.stderr)
    print(f"quarry pre-push: checked {len(checked)} commit(s) for {len(lines)} ref(s) "
          f"in {elapsed:.2f}s", file=sys.stderr)
    return 1 if problems else 0


def hook_path(repo: Repository) -> Path:
    path = repo.git("rev-parse", "--path-format=absolute", "--git-path", "hooks/pre-push")
    return Path(path)


HOOK_TEMPLATE = """#!/bin/sh
# {marker} (installed by scripts/quarry-validate install-hook).
# Validation runs before `git push`; this hook only checks receipts (#89).
top=$(git rev-parse --show-toplevel 2>/dev/null) || top=
script="$top/scripts/quarry-validate"
if [ -z "$top" ] || [ ! -f "$script" ]; then
    echo "quarry pre-push: scripts/quarry-validate is missing from this checkout;" >&2
    echo "quarry pre-push: rebase onto a main that contains it before pushing" >&2
    exit 1
fi
exec python3 "$script" check-push "$@"
"""


def command_install_hook(args) -> int:
    repo = Repository()
    path = hook_path(repo)
    content = HOOK_TEMPLATE.format(marker=HOOK_MARKER)
    if path.exists():
        existing = path.read_text(encoding="utf-8", errors="replace")
        if HOOK_MARKER in existing:
            pass
        elif PRE_COMMIT_MARKER in existing:
            backup = path.with_name("pre-push.pre-commit-backup")
            shutil.copy2(path, backup)
            say(f"replacing the pre-commit pre-push hook (backup: {backup})")
        elif not args.force:
            raise ValidateError(f"{path} is a custom hook; rerun with --force to replace it")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")
    path.chmod(0o755)
    say(f"installed {path}")
    return 0


def command_push(args) -> int:
    repo = Repository()
    path = hook_path(repo)
    if not path.exists() or HOOK_MARKER not in path.read_text(encoding="utf-8",
                                                               errors="replace"):
        raise ValidateError("the Quarry pre-push hook is not installed; run "
                            "`scripts/quarry-validate install-hook`")
    push = [repo.git_executable, "push", *args.push_arguments]
    for attempt in (1, 2):
        with tempfile.TemporaryDirectory(prefix="quarry-validate-") as directory:
            pending = Path(directory) / "pending"
            environment = dict(os.environ)
            environment[PENDING_ENV] = str(pending)
            status = subprocess.run(push, env=environment, check=False).returncode
            if status == 0:
                return 0
            missing = pending.read_text(encoding="utf-8").split() if pending.exists() else []
        if not missing or attempt == 2:
            return status
        say(f"the push needs {len(missing)} unvalidated commit(s); validating them "
            "before reconnecting")
        if not validate_commits(repo, missing, args):
            return 1
        say("validation passed; pushing again")
    return 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="quarry-validate",
        description="Validate exact commits before pushing them (see CONTRIBUTING.md).")
    commands = parser.add_subparsers(dest="command", required=True)

    def add_validation_options(sub: argparse.ArgumentParser) -> None:
        sub.add_argument("--build-jobs", type=int,
                         help=f"build parallelism (default ${BUILD_JOBS_ENV} or CPU count)")
        sub.add_argument("--test-jobs", type=int,
                         help=f"test parallelism (default ${TEST_JOBS_ENV} or CPU count)")
        sub.add_argument("--clean", action="store_true",
                         help="remove the validation build directory first")
        sub.add_argument("--force", action="store_true",
                         help="revalidate even if a valid receipt exists")

    validate = commands.add_parser("validate", help="validate commits (default HEAD)")
    validate.add_argument("revisions", nargs="*")
    add_validation_options(validate)
    validate.set_defaults(handler=command_validate)

    push = commands.add_parser(
        "push", help="git push, validating the commits it needs",
        usage="quarry-validate push [validation options] [--] [<git push arguments>...]")
    add_validation_options(push)
    push.set_defaults(handler=command_push, push_arguments=[])

    status = commands.add_parser("status", help="show receipt state (default HEAD)")
    status.add_argument("revisions", nargs="*")
    status.set_defaults(handler=command_status)

    install = commands.add_parser("install-hook", help="install the pre-push hook")
    install.add_argument("--force", action="store_true",
                         help="replace a custom pre-push hook")
    install.set_defaults(handler=command_install_hook)

    check = commands.add_parser("check-push", help="pre-push hook mode")
    check.add_argument("remote")
    check.add_argument("url", nargs="?")
    check.set_defaults(handler=command_check_push)
    return parser


_PUSH_VALUE_OPTIONS = ("--build-jobs", "--test-jobs")
_PUSH_FLAG_OPTIONS = ("--clean", "--force", "-h", "--help")


def split_push_arguments(argv: list[str]) -> tuple[list[str], list[str]]:
    """Leading validation options for `push`; everything else goes to git push.

    `--` ends the validation options explicitly; otherwise the first argument
    that is not a validation option starts the `git push` arguments, so
    `push -u origin main` works as written.
    """
    own, index = [], 0
    while index < len(argv):
        argument = argv[index]
        if argument == "--":
            return own, argv[index + 1:]
        if argument in _PUSH_FLAG_OPTIONS or argument.split("=", 1)[0] in _PUSH_VALUE_OPTIONS \
                and "=" in argument:
            own.append(argument)
            index += 1
        elif argument in _PUSH_VALUE_OPTIONS:
            own.extend(argv[index:index + 2])
            index += 2
        else:
            break
    return own, argv[index:]


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    push_arguments: list[str] = []
    if argv and argv[0] == "push":
        own, push_arguments = split_push_arguments(argv[1:])
        argv = ["push", *own]
    args = build_parser().parse_args(argv)
    if args.command == "push":
        args.push_arguments = push_arguments
    try:
        return args.handler(args)
    except ValidateError as error:
        say(f"error: {error}")
        return 2
    except KeyboardInterrupt:
        say("interrupted")
        return 130


if __name__ == "__main__":
    sys.exit(main())
