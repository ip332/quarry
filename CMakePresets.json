{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "QUARRY_WARNINGS_AS_ERRORS": "ON",
        "QUARRY_ENABLE_CLANG_TIDY": "OFF"
      }
    },
    {
      "name": "debug-clang-tidy",
      "displayName": "Debug with clang-tidy",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/debug-clang-tidy",
      "cacheVariables": {
        "QUARRY_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "docker-debug",
      "displayName": "Docker Debug",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/docker-debug"
    },
    {
      "name": "docker-debug-clang-tidy",
      "displayName": "Docker Debug with clang-tidy",
      "inherits": "debug-clang-tidy",
      "binaryDir": "${sourceDir}/build/docker-debug-clang-tidy"
    },
    {
      "name": "debug-fuzz",
      "displayName": "Debug fuzzers",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/debug-fuzz",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "QUARRY_BUILD_FUZZERS": "ON",
        "QUARRY_WARNINGS_AS_ERRORS": "ON",
        "QUARRY_ENABLE_CLANG_TIDY": "OFF"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "QUARRY_ENABLE_COVERAGE": "ON",
        "QUARRY_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "docker-coverage",
      "displayName": "Docker Coverage",
      "inherits": "coverage",
      "binaryDir": "${sourceDir}/build/docker-coverage"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "debug-clang-tidy",
      "configurePreset": "debug-clang-tidy"
    },
    {
      "name": "docker-debug",
      "configurePreset": "docker-debug"
    },
    {
      "name": "docker-debug-clang-tidy",
      "configurePreset": "docker-debug-clang-tidy"
    },
    {
      "name": "debug-fuzz",
      "configurePreset": "debug-fuzz"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "docker-coverage",
      "configurePreset": "docker-coverage"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-clang-tidy",
      "configurePreset": "debug-clang-tidy",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "docker-debug",
      "configurePreset": "docker-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "docker-debug-clang-tidy",
      "configurePreset": "docker-debug-clang-tidy",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "docker-coverage",
      "configurePreset": "docker-coverage",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
